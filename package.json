{
  "name": "agentguard-desktop",
  "productName": "AgentGuard",
  "private": true,
  "version": "0.1.1",
  "description": "AgentGuard — review AI-generated code changes for leaked secrets, security issues, broken tests and suspicious edits. Fully local, no paid APIs.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "tauri": "tauri",
    "rules:gen": "python3 tools/gen_rules.py",
    "rules:check": "python3 tools/check_rules.py",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
